{{!
    @template local_tarsus/brain_list

    Admin brain picker: every brain reachable by the configured API key, with
    its state and an activate action for the one this site should use.

    Context variables required for this template:
    * hasbrains - bool, whether the API key returned any brain.
    * hascurrent - bool, whether a brain is currently selected.
    * currentmissing - bool, whether the selected brain is absent from the list.
    * current - string, the currently selected brain id.
    * brains - array of {
          brainid, displayname, renamed, language, tag, created, statuslabel,
          badgeclass, selected, canactivate, activateurl }.

    Example context (json):
    {
        "hasbrains": true,
        "hascurrent": true,
        "currentmissing": false,
        "current": "lernlink-demo",
        "brains": [
            {
                "brainid": "lernlink-demo",
                "displayname": "lernlink-demo",
                "renamed": false,
                "language": "de",
                "tag": "default",
                "created": "1 January 2026, 12:00",
                "statuslabel": "Active",
                "badgeclass": "badge-success",
                "selected": true,
                "canactivate": false,
                "activateurl": "https://example.org/local/tarsus/brains.php"
            }
        ]
    }
}}
<div class="local-tarsus-brains">
    {{#hasbrains}}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{#str}}brain_col_id, local_tarsus{{/str}}</th>
                    <th scope="col">{{#str}}brain_col_status, local_tarsus{{/str}}</th>
                    <th scope="col">{{#str}}brain_col_language, local_tarsus{{/str}}</th>
                    <th scope="col">{{#str}}brain_col_tag, local_tarsus{{/str}}</th>
                    <th scope="col">{{#str}}brain_col_created, local_tarsus{{/str}}</th>
                    <th scope="col">{{#str}}brain_col_action, local_tarsus{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#brains}}
                    <tr>
                        <th scope="row" class="font-weight-normal">
                            {{displayname}}
                            {{#renamed}}
                                <div class="text-muted small">{{brainid}}</div>
                            {{/renamed}}
                        </th>
                        <td><span class="badge {{badgeclass}}">{{statuslabel}}</span></td>
                        <td>{{language}}</td>
                        <td>{{tag}}</td>
                        <td>{{created}}</td>
                        <td class="text-nowrap">
                            {{#selected}}
                                <span class="badge badge-primary">{{#str}}brain_inuse, local_tarsus{{/str}}</span>
                            {{/selected}}
                            {{#canactivate}}
                                <a class="btn btn-sm btn-outline-primary" href="{{activateurl}}">
                                    {{#str}}brain_activate, local_tarsus{{/str}}
                                </a>
                            {{/canactivate}}
                        </td>
                    </tr>
                {{/brains}}
            </tbody>
        </table>
        {{^hascurrent}}
            <div class="alert alert-warning">{{#str}}brain_none_selected, local_tarsus{{/str}}</div>
        {{/hascurrent}}
        {{#currentmissing}}
            <div class="alert alert-danger">{{#str}}brain_missing, local_tarsus, {{current}}{{/str}}</div>
        {{/currentmissing}}
    {{/hasbrains}}

    {{^hasbrains}}
        <div class="alert alert-info">{{#str}}brain_none_found, local_tarsus{{/str}}</div>
    {{/hasbrains}}
</div>
